# نموذج التحرير (نص + صور) عبر Vercel AI Gateway. اختر النموذج وقت النشر.
# أمثلة: anthropic/claude-sonnet-5.5  أو  anthropic/claude-haiku-5.5
AI_MODEL=

# نموذج الكتابة (التحرير وإعادة الصياغة). الافتراضي في الكود: anthropic/claude-sonnet-5.5.
# اضبطه فقط للتجاوز، مثل anthropic/claude-haiku-5.5 لخفض التكلفة. (AI_MODEL يبقى لقراءة الصور.)
AI_EDITOR_MODEL=

# مدقق دلالي اختياري: نموذج صغير يتأكد أن الموقف لم يتغير. اتركه فارغًا لتعطيله.
AI_VERIFIER_MODEL=

# نماذج بديلة مفصولة بفواصل تُجرَّب عند فشل النموذج الأساسي (اختياري).
AI_FALLBACK_MODELS=

# 1 = اطلب من AI Gateway عدم الاحتفاظ بالبيانات لدى المزوّد (قد يتطلب خطة تدعمه).
AI_ZDR=

# سقف يومي لطلبات الخادم (لكل نسخة تشغيل).
DAILY_REQUEST_CAP=3000

# للتطوير المحلي فقط: محرّر وهمي بلا نموذج. لا يعمل في الإنتاج.
MOCK_AI=

# محليًا فقط، إن لم تستعمل `vercel env pull`: مفتاح AI Gateway. على Vercel تُستعمل مصادقة OIDC تلقائيًا.
AI_GATEWAY_API_KEY=
